<Window x:Class="WinSpaces.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:WinSpaces.Converters"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        Title="WinSpaces — Dashboard" 
        Height="600" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToStatusIconConverter x:Key="StatusIconConverter"/>
            <converters:BoolToStatusColorConverter x:Key="StatusColorConverter"/>

            <!-- Style pour les titres de section -->
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <!-- Style pour les composants de diagnostic -->
            <Style x:Key="ComponentItemStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}"/>
                <Setter Property="Padding" Value="{StaticResource PaddingSmall}"/>
                <Setter Property="Margin" Value="0,4"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackground}" Padding="{StaticResource PaddingMedium}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="WinSpaces Dashboard" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="Surveillance des bureaux virtuels et gestes" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Bureaux :" 
                               Foreground="{DynamicResource TextSecondary}" 
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding DesktopCount}" 
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenu principal -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- État global de santé -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="État Global du Système" Style="{StaticResource SectionTitleStyle}"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="64" 
                                    Height="64" 
                                    CornerRadius="32"
                                    Background="{Binding Diagnostics.AllHealthy, Converter={StaticResource StatusColorConverter}}"
                                    Margin="0,0,16,0">
                                <TextBlock Text="{Binding Diagnostics.AllHealthy, Converter={StaticResource StatusIconConverter}}"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Diagnostics.GlobalStatus}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0">
                                    <Run Text="{Binding Diagnostics.HealthyCount, Mode=OneWay}"/>
                                    <Run Text="/"/>
                                    <Run Text="{Binding Diagnostics.TotalCount, Mode=OneWay}"/>
                                    <Run Text="composants opérationnels"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>


                <!-- Composants système (Diagnostic détaillé) -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                       Text="Composants Système" 
                                       Style="{StaticResource SectionTitleStyle}"
                                       Margin="0"/>
                            
                            <Button Grid.Column="1"
                                    Content="Actualiser"
                                    Click="RefreshButton_Click"
                                    Padding="12,6"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="{StaticResource CornerRadiusMedium}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Diagnostics.Components}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ComponentItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="32" 
                                                    Height="32" 
                                                    CornerRadius="{StaticResource CornerRadiusLarge}"
                                                    Background="{Binding IsHealthy, Converter={StaticResource StatusColorConverter}}"
                                                    Margin="0,0,12,0">
                                                <TextBlock Text="{Binding IsHealthy, Converter={StaticResource StatusIconConverter}}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ComponentName}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding StatusMessage}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>


                <!-- Options rapides -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Options" Style="{StaticResource SectionTitleStyle}"/>
                        
                        <CheckBox Content="Espace plein écran automatique"
                                  IsChecked="{Binding Options.FullscreenSpacesEnabled}"
                                  Foreground="{DynamicResource TextPrimary}"
                                  Margin="0,8,0,8"/>
                        
                        <CheckBox Content="Gestes trackpad"
                                  IsChecked="{Binding Options.GesturesEnabled}"
                                  Foreground="{DynamicResource TextPrimary}"
                                  Margin="0,0,0,8"/>
                        
                        <CheckBox Content="Démarrer avec Windows"
                                  IsChecked="{Binding Options.AutostartEnabled}"
                                  Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>


