<Window x:Class="WinSpaces.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:WinSpaces.Converters"
        xmlns:controls="clr-namespace:WinSpaces.Views.Controls"
        Title="WinSpaces"
        Width="1080" Height="700" MinWidth="860" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        AutomationProperties.Name="WinSpaces — Tableau de bord">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MacStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:EqualsToBoolConverter x:Key="EqualsToBool"/>
            <converters:EqualsToVisibilityConverter x:Key="EqualsToVisibility"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:CountToVisibilityConverter x:Key="CountToVisibility"/>
            <converters:BoolToStatusColorConverter x:Key="StatusColor"/>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Marge = place de l'ombre portée (retirée en plein écran) -->
    <Grid x:Name="Frame" Margin="14">
        <!-- Ombre sur un calque séparé : un effet sur le parent rendrait le texte flou -->
        <Border CornerRadius="12" Background="{DynamicResource WindowBackground}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.32"/>
            </Border.Effect>
        </Border>

        <Border x:Name="Chrome" CornerRadius="12" BorderThickness="1"
                BorderBrush="{DynamicResource WindowBorderBrush}" Background="{DynamicResource ContentBackground}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============ BARRE LATÉRALE ============ -->
                <Border x:Name="Sidebar" CornerRadius="11,0,0,11" Background="{DynamicResource SidebarBackground}"
                        BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <!-- Feux tricolores + zone de déplacement -->
                        <Grid DockPanel.Dock="Top" Height="52" Background="Transparent"
                              MouseLeftButtonDown="OnTitleBarMouseDown">
                            <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center"
                                        HorizontalAlignment="Left" Background="Transparent">
                                <Button Style="{StaticResource TrafficLight}" Background="#FF5F57" Content="✕"
                                        Click="OnCloseClick" ToolTip="Fermer"/>
                                <Button Style="{StaticResource TrafficLight}" Background="#FEBC2E" Content="−"
                                        Click="OnMinimizeClick" ToolTip="Réduire"/>
                                <Button Style="{StaticResource TrafficLight}" Background="#28C840" Content="+"
                                        Click="OnZoomClick" ToolTip="Agrandir"/>
                            </StackPanel>
                        </Grid>

                        <!-- Pied : version -->
                        <Border DockPanel.Dock="Bottom" Padding="20,12" BorderBrush="{DynamicResource SeparatorBrush}"
                                BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock Text="WinSpaces" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding Version}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="WinSpaces" Style="{StaticResource SidebarHeader}" Margin="20,0,0,4"/>
                                <controls:SidebarItem Glyph="&#xE80F;" Content="Aperçu" GroupName="nav"
                                    IsChecked="{Binding SelectedSection, Converter={StaticResource EqualsToBool}, ConverterParameter=overview}"/>
                                <controls:SidebarItem Glyph="&#xE9D9;" Content="Diagnostic" GroupName="nav"
                                    IsChecked="{Binding SelectedSection, Converter={StaticResource EqualsToBool}, ConverterParameter=diagnostics}"/>

                                <TextBlock Text="Journaux" Style="{StaticResource SidebarHeader}"/>
                                <controls:SidebarItem Glyph="&#xE8FD;" Content="Tous les messages" GroupName="nav"
                                    IsChecked="{Binding SelectedSection, Converter={StaticResource EqualsToBool}, ConverterParameter=logs}"/>
                                <controls:SidebarItem Glyph="&#xE783;" Content="Erreurs" GroupName="nav"
                                    Badge="{Binding Logs.ErrorCount}"
                                    IsChecked="{Binding SelectedSection, Converter={StaticResource EqualsToBool}, ConverterParameter=errors}"/>
                                <controls:SidebarItem Glyph="&#xE7BA;" Content="Avertissements" GroupName="nav"
                                    Detail="{Binding Logs.WarningCount}"
                                    IsChecked="{Binding SelectedSection, Converter={StaticResource EqualsToBool}, ConverterParameter=warnings}"/>

                                <!-- Répertoire des journaux -->
                                <TextBlock Text="Répertoire" Style="{StaticResource SidebarHeader}"/>
                                <controls:SidebarItem Glyph="&#xE8A5;" Content="winspaces.log" GroupName="nav"
                                    Detail="{Binding Logs.CurrentFileSize}"
                                    ToolTip="Journal courant"
                                    IsChecked="{Binding SelectedSection, Converter={StaticResource EqualsToBool}, ConverterParameter=file-current}"/>
                                <controls:SidebarItem Glyph="&#xE7B8;" Content="winspaces.log.old" GroupName="nav"
                                    Detail="{Binding Logs.ArchiveFileSize}"
                                    ToolTip="Archive (créée au-delà de 5 Mo)"
                                    Visibility="{Binding Logs.ArchiveExists, Converter={StaticResource BoolToVisibility}}"
                                    IsChecked="{Binding SelectedSection, Converter={StaticResource EqualsToBool}, ConverterParameter=file-archive}"/>
                                <Button Command="{Binding Logs.OpenFolderCommand}" Margin="10,1" Cursor="Hand"
                                        ToolTip="{Binding Logs.DirectoryPath}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="10,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" Width="26"
                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                    <TextBlock Text="Ouvrir le dossier…" Foreground="{DynamicResource TextSecondary}"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ============ CONTENU ============ -->
                <Grid Grid.Column="1">

                    <!-- == APERÇU == -->
                    <Grid Visibility="{Binding CurrentPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=overview}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown" Margin="28,22,28,16">
                            <StackPanel>
                                <TextBlock Text="Aperçu" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="{Binding Diagnostics.GlobalStatus}" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                            <Button Style="{StaticResource ToolbarButton}" Content="&#xE72C;" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Command="{Binding RefreshCommand}" ToolTip="Actualiser"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="28,0,28,28">
                                <!-- Cartes -->
                                <UniformGrid Columns="4" Margin="0,0,-12,24">
                                    <Button Style="{StaticResource StatCard}" Command="{Binding RefreshCommand}" ToolTip="Actualiser">
                                        <StackPanel>
                                            <TextBlock Text="&#xE7C4;" Style="{StaticResource Icon}" FontSize="18"
                                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>
                                            <TextBlock FontSize="26" FontWeight="SemiBold" Margin="0,10,0,0"
                                                       Foreground="{DynamicResource TextPrimary}">
                                                <Run Text="{Binding CurrentDesktopNumber, Mode=OneWay}"/><Run Text=" / " Foreground="{DynamicResource TextTertiary}"/><Run Text="{Binding DesktopCount, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="Espace actuel" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource StatCard}" Command="{Binding NavigateCommand}" CommandParameter="diagnostics">
                                        <StackPanel>
                                            <TextBlock Text="&#xEB51;" Style="{StaticResource Icon}" FontSize="18"
                                                       Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Left"/>
                                            <TextBlock FontSize="26" FontWeight="SemiBold" Margin="0,10,0,0"
                                                       Foreground="{DynamicResource TextPrimary}">
                                                <Run Text="{Binding Diagnostics.HealthyCount, Mode=OneWay}"/><Run Text=" / " Foreground="{DynamicResource TextTertiary}"/><Run Text="{Binding Diagnostics.TotalCount, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="Composants opérationnels" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource StatCard}" Command="{Binding NavigateCommand}" CommandParameter="errors">
                                        <StackPanel>
                                            <TextBlock Text="&#xE783;" Style="{StaticResource Icon}" FontSize="18"
                                                       Foreground="{DynamicResource ErrorBrush}" HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding Logs.ErrorCount}" FontSize="26" FontWeight="SemiBold"
                                                       Margin="0,10,0,0" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="Erreurs dans le journal" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource StatCard}" Command="{Binding NavigateCommand}" CommandParameter="warnings">
                                        <StackPanel>
                                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="18"
                                                       Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding Logs.WarningCount}" FontSize="26" FontWeight="SemiBold"
                                                       Margin="0,10,0,0" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="Avertissements" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>

                                <!-- Réglages -->
                                <TextBlock Text="Réglages" Style="{StaticResource GroupTitle}"/>
                                <Border Style="{StaticResource InsetGroup}" Margin="0,0,0,24">
                                    <StackPanel>
                                        <Border Style="{StaticResource GroupRow}">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource MacSwitch}"
                                                          IsChecked="{Binding FullscreenSpacesEnabled}" VerticalAlignment="Center"/>
                                                <StackPanel>
                                                    <TextBlock Text="Espace plein écran automatique" Foreground="{DynamicResource TextPrimary}"/>
                                                    <TextBlock Text="Une app en plein écran obtient son propre bureau, supprimé à la sortie."
                                                               FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource GroupRow}">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource MacSwitch}"
                                                          IsChecked="{Binding GesturesEnabled}" VerticalAlignment="Center"/>
                                                <StackPanel>
                                                    <TextBlock Text="Gestes du trackpad" Foreground="{DynamicResource TextPrimary}"/>
                                                    <TextBlock Text="Balayage 3/4 doigts (Précision Touchpad) ou molette horizontale."
                                                               FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource GroupRow}" BorderThickness="0">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource MacSwitch}"
                                                          IsChecked="{Binding AutostartEnabled}" VerticalAlignment="Center"/>
                                                <StackPanel>
                                                    <TextBlock Text="Ouvrir au démarrage de Windows" Foreground="{DynamicResource TextPrimary}"/>
                                                    <TextBlock Text="Ajoute WinSpaces aux applications de démarrage de la session."
                                                               FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Dernières erreurs -->
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PushButton}" Content="Tout afficher"
                                            Command="{Binding NavigateCommand}" CommandParameter="errors"/>
                                    <TextBlock Text="Dernières erreurs" Style="{StaticResource GroupTitle}" Margin="4,0,0,0"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Style="{StaticResource InsetGroup}">
                                    <Grid>
                                        <TextBlock Text="Aucune erreur enregistrée dans le journal."
                                                   Foreground="{DynamicResource TextSecondary}" Margin="14,14"
                                                   Visibility="{Binding Logs.RecentErrors.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Inverse}"/>
                                        <ItemsControl ItemsSource="{Binding Logs.RecentErrors}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Cursor="Hand"
                                                            Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bg" Style="{StaticResource GroupRow}" Background="Transparent">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ListHoverBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="11.5" Foreground="{DynamicResource TextTertiary}" Margin="12,0,0,0"/>
                                                            <TextBlock Text="&#xE783;" Style="{StaticResource Icon}" FontSize="13"
                                                                       Foreground="{DynamicResource ErrorBrush}" Margin="0,0,10,0"/>
                                                            <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextPrimary}"/>
                                                        </DockPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- == DIAGNOSTIC == -->
                    <Grid Visibility="{Binding CurrentPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=diagnostics}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown" Margin="28,22,28,16">
                            <StackPanel>
                                <TextBlock Text="Diagnostic" Style="{StaticResource PageTitle}"/>
                                <TextBlock Style="{StaticResource PageSubtitle}">
                                    <Run Text="{Binding Diagnostics.HealthyCount, Mode=OneWay}"/>
                                    <Run Text="sur"/>
                                    <Run Text="{Binding Diagnostics.TotalCount, Mode=OneWay}"/>
                                    <Run Text="composants opérationnels"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Style="{StaticResource PushButton}" Content="Actualiser" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Command="{Binding RefreshCommand}"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Border Style="{StaticResource InsetGroup}" Margin="28,0,28,28" VerticalAlignment="Top">
                                <ItemsControl ItemsSource="{Binding Diagnostics.Components}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource GroupRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="9" Height="9" Margin="0,5,12,0" VerticalAlignment="Top"
                                                             Fill="{Binding IsHealthy, Converter={StaticResource StatusColor}}"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding ComponentName}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}"/>
                                                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding DetailedStatus}" FontSize="11.5"
                                                               Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </ScrollViewer>
                    </Grid>

                    <!-- == JOURNAUX == -->
                    <Grid Visibility="{Binding CurrentPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=logs}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="210"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Barre d'outils -->
                        <Grid Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown" Margin="28,18,20,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Logs.Title}" Style="{StaticResource PageTitle}"/>
                                <TextBlock Style="{StaticResource PageSubtitle}">
                                    <Run Text="{Binding Logs.FileName, Mode=OneWay}"/>
                                    <Run Text="·"/>
                                    <Run Text="{Binding Logs.StatusText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Style="{StaticResource SearchField}" Width="220" Margin="0,0,8,0" Tag="Rechercher"
                                         Text="{Binding Logs.SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"/>
                                <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding Logs.IsLive}"
                                              IsEnabled="{Binding Logs.IsArchive, Converter={StaticResource EqualsToBool}, ConverterParameter=False}"
                                              Content="&#xE768;" ToolTip="Suivi en direct des nouvelles entrées"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="&#xE72C;" Command="{Binding Logs.RefreshCommand}" ToolTip="Recharger"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="&#xE8C8;" Command="{Binding Logs.CopyVisibleCommand}" ToolTip="Copier les entrées affichées"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="&#xE8A7;" Command="{Binding Logs.OpenFileCommand}" ToolTip="Ouvrir le fichier"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="&#xE838;" Command="{Binding Logs.OpenFolderCommand}" ToolTip="Afficher dans l'Explorateur"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="&#xE74D;" Command="{Binding Logs.ClearCommand}" ToolTip="Effacer le journal courant"/>
                            </StackPanel>
                        </Grid>

                        <!-- Contrôle segmenté -->
                        <Border Grid.Row="1" HorizontalAlignment="Left" Margin="28,0,0,10" CornerRadius="7" Padding="1"
                                Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="level" Content="Tout"
                                             IsChecked="{Binding Logs.LevelFilter, Converter={StaticResource EqualsToBool}, ConverterParameter=All}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="level" Content="Erreurs"
                                             IsChecked="{Binding Logs.LevelFilter, Converter={StaticResource EqualsToBool}, ConverterParameter=Error}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="level" Content="Avertissements"
                                             IsChecked="{Binding Logs.LevelFilter, Converter={StaticResource EqualsToBool}, ConverterParameter=Warning}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="level" Content="Infos"
                                             IsChecked="{Binding Logs.LevelFilter, Converter={StaticResource EqualsToBool}, ConverterParameter=Info}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="level" Content="Debug"
                                             IsChecked="{Binding Logs.LevelFilter, Converter={StaticResource EqualsToBool}, ConverterParameter=Debug}"/>
                            </StackPanel>
                        </Border>

                        <!-- Liste -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1" Padding="28,5,28,5">
                                <Grid TextElement.Foreground="{DynamicResource TextTertiary}" TextElement.FontSize="11"
                                      TextElement.FontWeight="SemiBold">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="HEURE"/>
                                    <TextBlock Grid.Column="1" Text="TYPE"/>
                                    <TextBlock Grid.Column="2" Text="MESSAGE"/>
                                </Grid>
                            </Border>
                            <ListView x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Logs.Entries}"
                                      SelectedItem="{Binding Logs.SelectedEntry}" SelectionMode="Single"
                                      Background="Transparent" BorderThickness="0" Padding="0,4"
                                      ItemContainerStyle="{StaticResource LogRow}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.CanContentScroll="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="78"/>
                                                <ColumnDefinition Width="76"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Style="{StaticResource LevelPill}">
                                                <TextBlock Text="{Binding LevelLabel}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Summary}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="11"
                                                       Foreground="{DynamicResource TextTertiary}" Margin="8,0,0,0"
                                                       ToolTip="Contient une trace détaillée"
                                                       Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                        Visibility="{Binding Logs.VisibleCount, Converter={StaticResource CountToVisibility}, ConverterParameter=Inverse}">
                                <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" FontSize="30" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiary}"/>
                                <TextBlock Text="Aucune entrée" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="Rien ne correspond aux filtres actuels." FontSize="12" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiary}"/>
                            </StackPanel>
                        </Grid>

                        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="Transparent"
                                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>

                        <!-- Détail -->
                        <Border Grid.Row="4" Style="{StaticResource InsetGroup}" Margin="20,0,20,16">
                            <Grid>
                                <TextBlock Text="Sélectionnez une entrée pour afficher son détail."
                                           Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding Logs.HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"/>
                                <DockPanel DataContext="{Binding Logs.SelectedEntry}"
                                           Visibility="{Binding DataContext.Logs.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                                    <Border DockPanel.Dock="Top" Padding="14,9" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource PushButton}" Content="Copier"
                                                    Command="{Binding DataContext.Logs.CopySelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <Border Style="{StaticResource LevelPill}" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding LevelLabel}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Text="{Binding DateTimeText}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        </DockPanel>
                                    </Border>
                                    <TextBox Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="10,8"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                                             VerticalScrollBarVisibility="Auto"/>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
