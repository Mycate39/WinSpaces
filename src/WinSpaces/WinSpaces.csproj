<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinSpaces</RootNamespace>
    <AssemblyName>WinSpaces</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>2.5.2</Version>
    <Authors>WinSpaces contributors</Authors>
    <Description>macOS Spaces pour Windows — bureaux virtuels avec plein écran auto, gestes trackpad et dashboard WPF</Description>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <!-- Spotlight Module Dependencies -->
  <ItemGroup>
    <PackageReference Include="Lucene.Net" Version="4.8.0-beta00018" />
    <PackageReference Include="NCalc" Version="6.2.0" />
  </ItemGroup>

</Project>