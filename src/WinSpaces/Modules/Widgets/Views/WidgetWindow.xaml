<Window x:Class="WinSpaces.Modules.Widgets.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Style pour le conteneur du widget -->
        <Style x:Key="WidgetContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="#E0FFFFFF"/>
            <Setter Property="BorderBrush" Value="#40000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" 
                                    Direction="270" 
                                    ShadowDepth="4" 
                                    BlurRadius="12" 
                                    Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style pour le titre du widget -->
        <Style x:Key="WidgetTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Style pour le contenu du widget -->
        <Style x:Key="WidgetContentStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#34495E"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <!-- Conteneur principal -->
    <Border Style="{StaticResource WidgetContainerStyle}" 
            MouseLeftButtonDown="OnDragStart"
            Cursor="SizeAll">
        <Grid>
            <!-- Contenu dynamique chargé par code-behind -->
            <ContentPresenter x:Name="WidgetContentPresenter"/>
        </Grid>
    </Border>
</Window>
