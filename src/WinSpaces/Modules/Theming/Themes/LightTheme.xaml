<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Palette claire style macOS. Le ThemeEngine remplace ce dictionnaire
         en bloc : chaque clé doit exister dans les DEUX thèmes. -->
    <SolidColorBrush x:Key="WindowBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ContentBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#FFF2F1F6"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFF5F5F7"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="BorderColor" Color="#FFE3E3E8"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#26000000"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#FFE5E5EA"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#FF1D1D1F"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FF6E6E73"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#FFAEAEB2"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF007AFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF3395FF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F007AFF"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#0F000000"/>
    <SolidColorBrush x:Key="SidebarSelectionBrush" Color="#1A000000"/>
    <SolidColorBrush x:Key="ListHoverBrush" Color="#0A000000"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#24007AFF"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFFF3B30"/>
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#1FFF3B30"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFF9500"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#24FF9500"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#FF007AFF"/>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#1A007AFF"/>
    <SolidColorBrush x:Key="DebugBrush" Color="#FF8E8E93"/>
    <SolidColorBrush x:Key="DebugSoftBrush" Color="#1F8E8E93"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF34C759"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2434C759"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#40000000"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FF1D1D1F"/>
</ResourceDictionary>
