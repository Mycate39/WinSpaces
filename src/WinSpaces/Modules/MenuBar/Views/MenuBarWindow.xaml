<Window x:Class="WinSpaces.Modules.MenuBar.Views.MenuBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinSpaces.Modules.MenuBar.ViewModels"
        Title="WinSpaces Menu Bar"
        Height="32"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="0"
        Top="0">

    <Window.Resources>
        <!-- Style pour les indicateurs système -->
        <Style x:Key="IndicatorButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#40FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#60FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style pour le texte de l'horloge -->
        <Style x:Key="ClockTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>
    </Window.Resources>

    <!-- Conteneur principal avec fond translucide Acrylic -->
    <Border Background="#DD1E1E1E" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Partie gauche : Logo WinSpaces + Menu global -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" 
                       VerticalAlignment="Center" Margin="10,0">
                
                <!-- Logo WinSpaces -->
                <TextBlock Text="⬜" FontSize="16" Foreground="#4A90E2" 
                          VerticalAlignment="Center" Margin="0,0,15,0"/>
                
                <!-- Menu global (placeholder) -->
                <TextBlock Text="WinSpaces" FontSize="13" FontWeight="SemiBold"
                          Foreground="#E0E0E0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Partie droite : Indicateurs système -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" 
                       VerticalAlignment="Center" Margin="10,0">

                <!-- Indicateur WiFi/Réseau -->
                <Button Style="{StaticResource IndicatorButtonStyle}"
                       Command="{Binding OpenNetworkSettingsCommand}"
                       ToolTip="{Binding NetworkName}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding WiFiIcon}" FontSize="14"/>
                    </StackPanel>
                </Button>

                <!-- Indicateur Volume -->
                <Button Style="{StaticResource IndicatorButtonStyle}"
                       Command="{Binding ToggleMuteCommand}"
                       ToolTip="{Binding VolumeLevel, StringFormat='Volume: {0}%'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding VolumeIcon}" FontSize="14"/>
                        <TextBlock Text="{Binding VolumeLevel, StringFormat='{}{0}%'}" 
                                  Style="{StaticResource ClockTextStyle}" FontSize="11"/>
                    </StackPanel>
                </Button>

                <!-- Indicateur Batterie -->
                <Button Style="{StaticResource IndicatorButtonStyle}"
                       Command="{Binding OpenBatterySettingsCommand}">
                    <Button.ToolTip>
                        <StackPanel>
                            <TextBlock Text="{Binding BatteryLevel, StringFormat='Batterie: {0}%'}"/>
                            <TextBlock Text="{Binding IsCharging, StringFormat='En charge: {0}'}" 
                                      FontSize="10" Foreground="Gray"/>
                        </StackPanel>
                    </Button.ToolTip>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding BatteryIcon}" FontSize="14"/>
                        <TextBlock Text="{Binding BatteryLevel, StringFormat='{}{0}%'}" 
                                  Style="{StaticResource ClockTextStyle}" FontSize="11"/>
                    </StackPanel>
                </Button>

                <!-- Séparateur -->
                <Border Width="1" Height="20" Background="#3A3A3A" Margin="5,0"/>

                <!-- Horloge -->
                <Button Style="{StaticResource IndicatorButtonStyle}"
                       Command="{Binding OpenDateTimeSettingsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Vertical" Margin="0,-2">
                            <TextBlock Text="{Binding CurrentDate}" 
                                      Style="{StaticResource ClockTextStyle}" 
                                      FontSize="9" 
                                      HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding CurrentTime}" 
                                      Style="{StaticResource ClockTextStyle}" 
                                      FontSize="13" 
                                      FontWeight="Bold"
                                      HorizontalAlignment="Right"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
